# ThreatSync OS — Environment Configuration Template
# Copy this file to .env and fill in all required values before running.

# -------------------------------------------------------
# Application
# -------------------------------------------------------
NODE_ENV=development
PORT=3001
FRONTEND_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:3001/api/v1

# -------------------------------------------------------
# Database (Required)
# Production: Use a managed PostgreSQL instance.
# Development: Local PostgreSQL or docker compose postgres.
# -------------------------------------------------------
DATABASE_URL="postgresql://postgres:<local-password>@localhost:5432/threatsync?schema=public"

# -------------------------------------------------------
# Redis Queue (Required in production)
# In development, ENABLE_IN_MEMORY_QUEUE_FALLBACK=true allows
# running without a Redis daemon (ioredis-mock is used instead).
# In production, REDIS_URL is mandatory and the fallback is disabled.
# -------------------------------------------------------
REDIS_URL="redis://localhost:6379"
ENABLE_IN_MEMORY_QUEUE_FALLBACK="true"

# -------------------------------------------------------
# Security & Session Secrets (Required)
# Generate all three with: openssl rand -base64 48
# JWT_SECRET:         signs short-lived access tokens (15 min)
# JWT_REFRESH_SECRET: signs long-lived refresh tokens (7 days)
# SESSION_SECRET:     fallback encryption key for integration secrets
# -------------------------------------------------------
JWT_SECRET="<generate-a-random-secret-at-least-32-characters>"
JWT_REFRESH_SECRET="<generate-a-second-random-secret-at-least-32-characters>"
SESSION_SECRET="<generate-a-third-random-secret-at-least-16-characters>"

# -------------------------------------------------------
# Integration Secret Encryption Key (Recommended in production)
# Used for AES-256-GCM encryption of webhook secrets at rest.
# Falls back to SESSION_SECRET if not set.
# Generate with: openssl rand -base64 32
# -------------------------------------------------------
INTEGRATION_ENCRYPTION_KEY="<generate-a-32-byte-random-key>"

# -------------------------------------------------------
# Rate Limiting (Configurable per endpoint)
# -------------------------------------------------------
AUTH_RATE_LIMIT_MAX=10
AUTH_RATE_LIMIT_WINDOW_MS=900000
INGEST_RATE_LIMIT_MAX=300
INGEST_RATE_LIMIT_WINDOW_MS=60000
INTELLIGENCE_RATE_LIMIT_MAX=60
INTELLIGENCE_RATE_LIMIT_WINDOW_MS=60000

# -------------------------------------------------------
# External Threat Intelligence (Optional)
# When not configured, the local intelligence cache is used.
# External enrichment status is clearly reported as UNAVAILABLE
# — it is never disguised as a successful local result.
# -------------------------------------------------------
VIRUSTOTAL_API_KEY=""
ABUSEIPDB_API_KEY=""

# -------------------------------------------------------
# Worker Process Control
# Set DISABLE_QUEUE_WORKER=true on API-only instances when
# running the worker as a separate process (npm run start:worker).
# -------------------------------------------------------
DISABLE_QUEUE_WORKER="false"
