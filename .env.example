# ThreatSync OS Environment Configuration

# Application Ports
PORT=3001
FRONTEND_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:3001/api/v1

# Database Configuration
# Production-ready default: PostgreSQL with Prisma
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/threatsync?schema=public"

# Redis Queue Configuration
# In production (NODE_ENV=production), REDIS_URL is REQUIRED unless ENABLE_IN_MEMORY_QUEUE_FALLBACK=true is set.
REDIS_URL="redis://localhost:6379"
ENABLE_IN_MEMORY_QUEUE_FALLBACK="false"


# Security and Sessions
JWT_SECRET="threatsync_super_secret_access_token_key_12345"
JWT_REFRESH_SECRET="threatsync_super_secret_refresh_token_key_67890"

# AI Service Configuration (Options: google, openai, anthropic, mock)
AI_PROVIDER="mock"
GEMINI_API_KEY=""
OPENAI_API_KEY=""
ANTHROPIC_API_KEY=""

# Integrations (Optional/Mock fallback if empty)
VIRUSTOTAL_API_KEY=""
ABUSEIPDB_API_KEY=""
SLACK_WEBHOOK_URL=""
