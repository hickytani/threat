# ThreatSync OS Environment Configuration

# Application Ports
PORT=3001
NEXT_PUBLIC_API_URL=http://localhost:3001/api/v1

# Database Configuration
# For PostgreSQL: postgresql://username:password@localhost:5432/threatsync?schema=public
# For SQLite (default zero-dependency development): file:../database/prisma/dev.db
DATABASE_URL="file:../database/prisma/dev.db"

# Redis Queue Configuration (Empty/Unset forces in-memory event-queue fallback)
REDIS_URL="redis://localhost:6379"

# Security and Sessions
JWT_SECRET="threatsync_super_secret_access_token_key_12345"
JWT_REFRESH_SECRET="threatsync_super_secret_refresh_token_key_67890"

# AI Service Configuration (Options: google, openai, anthropic, mock)
AI_PROVIDER="mock"
GEMINI_API_KEY=""
OPENAI_API_KEY=""
ANTHROPIC_API_KEY=""

# Integrations (Optional/Mock fallback if empty)
VIRUSTOTAL_API_KEY=""
ABUSEIPDB_API_KEY=""
SLACK_WEBHOOK_URL=""
