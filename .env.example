# ThreatSync OS — Environment Configuration
# Copy this file to .env and fill in the values.
# DO NOT commit .env to version control.

# ============================================================
# APPLICATION
# ============================================================
NODE_ENV=development
PORT=3001

# ============================================================
# DATABASE (PostgreSQL)
# ============================================================
DATABASE_URL="postgresql://postgres:<local-password>@localhost:5432/threatsync?schema=public"

# ============================================================
# REDIS / QUEUE
# ============================================================
# In development, ENABLE_IN_MEMORY_QUEUE_FALLBACK=true allows startup without Redis.
# In production (NODE_ENV=production), REDIS_URL is REQUIRED and fallback is FORBIDDEN.
REDIS_URL="redis://localhost:6379"
ENABLE_IN_MEMORY_QUEUE_FALLBACK="true"

# Set to "true" to disable the embedded BullMQ worker on the API process
# when running a dedicated worker container (see docker-compose.yml).
# DISABLE_QUEUE_WORKER="false"

# ============================================================
# SECURITY SECRETS
# Generate unique values: openssl rand -base64 48
# Minimum lengths: JWT_SECRET 32 chars, SESSION_SECRET 16 chars.
# In production, secrets must not contain: secret, password, default, change_in_production
# ============================================================
JWT_SECRET="<generate-a-local-secret-at-least-32-characters>"
JWT_REFRESH_SECRET="<generate-a-second-local-secret-at-least-32-characters>"
# REFRESH_TOKEN_SECRET is an alias for JWT_REFRESH_SECRET (either works)
# REFRESH_TOKEN_SECRET="<same-or-separate-refresh-secret>"
SESSION_SECRET="<generate-a-third-local-secret-at-least-16-characters>"

# ============================================================
# FRONTEND / CORS
# ============================================================
# FRONTEND_URL must match the exact origin of the Next.js frontend.
# WEB_PUBLIC_URL is an alias for FRONTEND_URL (either works).
FRONTEND_URL=http://localhost:3000
# WEB_PUBLIC_URL=http://localhost:3000

# Public API URL baked into the Next.js build.
# Must be set at BUILD TIME, not at runtime.
NEXT_PUBLIC_API_URL=http://localhost:3001/api/v1

# ============================================================
# DEMO / SEED CONTROL
# ============================================================
# Set to "true" ONLY in development/staging to allow npm run db:seed and /seed-demo endpoint.
# Always "false" in production. Blocked entirely if NODE_ENV=production.
ALLOW_DEMO_SEED="false"

# ============================================================
# RATE LIMITING
# ============================================================
AUTH_RATE_LIMIT_MAX=10
AUTH_RATE_LIMIT_WINDOW_MS=900000
INGEST_RATE_LIMIT_MAX=300
INGEST_RATE_LIMIT_WINDOW_MS=60000
INTELLIGENCE_RATE_LIMIT_MAX=60
INTELLIGENCE_RATE_LIMIT_WINDOW_MS=60000
WEBHOOK_RATE_LIMIT_MAX=300
WEBHOOK_RATE_LIMIT_WINDOW_MS=60000

# ============================================================
# OPTIONAL: THREAT INTELLIGENCE ENRICHMENT
# Leave blank to use local deterministic matching only.
# ============================================================
# VIRUSTOTAL_API_KEY=
# ABUSEIPDB_API_KEY=
