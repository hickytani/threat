# ThreatSync OS Environment Configuration

# Application Ports
NODE_ENV=development
PORT=3001
FRONTEND_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:3001/api/v1

# Database Configuration
# Production-ready default: PostgreSQL with Prisma
DATABASE_URL="postgresql://postgres:<local-password>@localhost:5432/threatsync?schema=public"

# Redis Queue Configuration
# In production (NODE_ENV=production), REDIS_URL is REQUIRED unless ENABLE_IN_MEMORY_QUEUE_FALLBACK=true is set.
REDIS_URL="redis://localhost:6379"
ENABLE_IN_MEMORY_QUEUE_FALLBACK="true"


# Security and Sessions
JWT_SECRET="<generate-a-local-secret-at-least-32-characters>"
JWT_REFRESH_SECRET="<generate-a-second-local-secret-at-least-32-characters>"
SESSION_SECRET="<generate-a-third-local-secret-at-least-32-characters>"

# Demo and abuse-control boundaries
ALLOW_DEMO_SEED="false"
AUTH_RATE_LIMIT_MAX=10
AUTH_RATE_LIMIT_WINDOW_MS=900000
INGEST_RATE_LIMIT_MAX=300
INGEST_RATE_LIMIT_WINDOW_MS=60000
INTELLIGENCE_RATE_LIMIT_MAX=60
INTELLIGENCE_RATE_LIMIT_WINDOW_MS=60000

