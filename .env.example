# ThreatSync OS Environment Configuration

# Application Ports
PORT=3000
FRONTEND_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8010/api/v1

# Database Configuration
# Production-ready default: PostgreSQL with Prisma
DATABASE_URL="postgresql://postgres:<local-password>@localhost:5432/threatsync?schema=public"

# Redis Queue Configuration
# In production (NODE_ENV=production), REDIS_URL is REQUIRED unless ENABLE_IN_MEMORY_QUEUE_FALLBACK=true is set.
REDIS_URL="redis://localhost:6379"
ENABLE_IN_MEMORY_QUEUE_FALLBACK="false"


# Security and Sessions
JWT_SECRET="<generate-a-local-secret-at-least-32-characters>"
JWT_REFRESH_SECRET="<generate-a-second-local-secret-at-least-32-characters>"

# AI Service Configuration (Options: google, openai, anthropic, mock)
AI_PROVIDER="mock"
GEMINI_API_KEY=""
OPENAI_API_KEY=""
ANTHROPIC_API_KEY=""

# Integrations (Optional/Mock fallback if empty)
VIRUSTOTAL_API_KEY=""
ABUSEIPDB_API_KEY=""
SLACK_WEBHOOK_URL=""
