// ThreatSync OS Modernized Database Schema (PostgreSQL)

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// User Access Roles
enum UserRole {
  SUPER_ADMIN
  ORG_ADMIN
  SOC_MANAGER
  SECURITY_ANALYST
  COMPLIANCE_VIEWER
  EXECUTIVE_VIEWER
}

// Alert Severity Levels
enum AlertSeverity {
  INFORMATIONAL
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

// Alert Lifecycle Statuses
enum AlertStatus {
  NEW
  INVESTIGATING
  ESCALATED
  RESOLVED
}

// Incident Lifecycle Statuses
enum IncidentStatus {
  OPEN
  TRIAGED
  INVESTIGATING
  CONTAINMENT_IN_PROGRESS
  CONTAINED
  REMEDIATION_IN_PROGRESS
  MONITORING
  RESOLVED
  CLOSED
}

// Asset Infrastructure Types
enum AssetType {
  SERVER
  WORKSTATION
  DATABASE
  NETWORK_DEVICE
  CLOUD_BUCKET
  VIRTUAL_MACHINE
  CLOUD_INSTANCE
  CONTAINER
  APPLICATION
  API
  USER_IDENTITY
  SERVICE_ACCOUNT
  STORAGE_BUCKET
}

// Asset Business Criticality Levels
enum AssetCriticality {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

// Environment Categories
enum Environment {
  PROD
  DEV
  STAGING
}

// Remediation Task Statuses
enum TaskStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  BLOCKED
}

// Evidence Scanning Statuses
enum EvidenceStatus {
  SCANNING
  CLEAN
  MALICIOUS
  FAILED
}

// User Model
model User {
  id           String               @id @default(uuid())
  email        String               @unique
  passwordHash String
  fullName     String
  isActive     Boolean              @default(true)
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt
  memberships  OrganizationMember[]
  sessions     Session[]

  @@index([email])
}

// Organization Model (Tenant)
model Organization {
  id           String               @id @default(uuid())
  name         String
  size         String?
  industry     String?
  country      String?
  timeZone     String?
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt
  members      OrganizationMember[]
  assets       Asset[]
  alerts       Alert[]
  incidents    Incident[]
  iocs         IOC[]
  events       SecurityEvent[]
  rules        DetectionRule[]
  integrations Integration[]
  auditLogs    AuditLog[]
}

// Organization Member Model (RBAC mapping)
model OrganizationMember {
  id             String       @id @default(uuid())
  organizationId String
  userId         String
  role           UserRole     @default(SECURITY_ANALYST)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
  @@index([organizationId])
  @@index([userId])
}

// Session Model (Session Revocation & Refresh Tokens)
model Session {
  id             String        @id @default(uuid())
  userId         String
  organizationId String?       // Active tenant context bound to session
  token          String        @unique
  expiresAt      DateTime
  revoked        Boolean       @default(false)
  ipAddress      String?
  userAgent      String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
  @@index([organizationId])
}

// Asset Model
model Asset {
  id                  String               @id @default(uuid())
  organizationId      String
  hostname            String
  displayName         String
  type                AssetType            @default(WORKSTATION)
  operatingSystem     String?
  ipAddress           String
  macAddress          String?
  cloudProvider       String?
  region              String?
  owner               String?
  department          String?
  businessCriticality AssetCriticality     @default(MEDIUM)
  environment         Environment          @default(DEV)
  isInternetFacing    Boolean              @default(false)
  monitoringStatus    String               @default("ACTIVE") // ACTIVE, OFFLINE, DISCOVERED
  riskScore           Float                @default(0.0)      // 0 - 100
  tags                Json                 @default("[]")     // Actual Postgres JSONB array
  vulnerabilityCount  Int                  @default(0)
  activeAlertCount    Int                  @default(0)
  lastObserved        DateTime?
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  organization        Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  alerts              Alert[]
  vulnerabilities     AssetVulnerability[]

  @@index([organizationId])
  @@index([ipAddress])
}

// Alert Model
model Alert {
  id                  String        @id @default(uuid())
  organizationId      String
  title               String
  description         String
  severity            AlertSeverity @default(MEDIUM)
  status              AlertStatus   @default(NEW)
  category            String
  source              String
  detectionRuleId     String?
  assetId             String?
  userIdentity        String?
  ipAddress           String?
  domain              String?
  fileHash            String?
  confidenceScore     Float         @default(50.0)
  rawEvent            Json          @default("{}")      // Actual Postgres JSONB payload
  assignedAnalystId   String?
  assignedAnalystName String?
  incidentId          String?
  tags                Json          @default("[]")      // Actual Postgres JSONB array
  mitreTechniques     Json          @default("[]")      // Actual Postgres JSONB array
  timestamp           DateTime      @default(now())
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt
  organization        Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  asset               Asset?        @relation(fields: [assetId], references: [id], onDelete: SetNull)
  incident            Incident?     @relation(fields: [incidentId], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([organizationId, timestamp])
  @@index([assetId])
  @@index([incidentId])
  @@index([status])
  @@index([severity])
  @@index([createdAt])
  @@index([ipAddress])
  @@index([domain])
  @@index([fileHash])
}

// Incident Model
model Incident {
  id                  String          @id @default(uuid())
  organizationId      String
  title               String
  summary             String
  severity            AlertSeverity   @default(MEDIUM)
  priority            AlertSeverity   @default(MEDIUM)
  status              IncidentStatus  @default(OPEN)
  incidentType        String
  assignedAnalystId   String?
  assignedAnalystName String?
  assignedTeam        String?
  detectionTime       DateTime        @default(now())
  acknowledgedTime    DateTime?
  containmentTime     DateTime?
  resolutionTime      DateTime?
  slaDeadline         DateTime?
  rootCause           String?
  impact              String?
  resolution          String?
  lessonsLearned      String?
  tags                Json            @default("[]")      // Actual Postgres JSONB array
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt
  organization        Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  alerts              Alert[]
  tasks               IncidentTask[]
  comments            IncidentComment[]
  evidence            Evidence[]

  @@index([organizationId])
  @@index([status])
  @@index([createdAt])
  @@index([assignedAnalystId])
}

// Incident Task Model
model IncidentTask {
  id                 String     @id @default(uuid())
  incidentId         String
  title              String
  ownerId            String?
  ownerName          String?
  priority           AlertSeverity @default(MEDIUM)
  dueDate            DateTime?
  status             TaskStatus @default(PENDING)
  dependencies       Json       @default("[]")      // Actual Postgres JSONB array
  completionEvidence String?
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt
  incident           Incident   @relation(fields: [incidentId], references: [id], onDelete: Cascade)

  @@index([incidentId])
}

// Incident Comment Model
model IncidentComment {
  id             String   @id @default(uuid())
  incidentId     String
  authorId       String
  authorName     String
  content        String
  isInternalOnly Boolean  @default(false)
  createdAt      DateTime @default(now())
  incident       Incident @relation(fields: [incidentId], references: [id], onDelete: Cascade)

  @@index([incidentId])
}

// Evidence Model
model Evidence {
  id             String         @id @default(uuid())
  incidentId     String
  fileName       String
  fileSize       Int
  mimeType       String
  uploadedById   String
  uploadedByName String
  fileUrl        String
  status         EvidenceStatus @default(SCANNING)
  createdAt      DateTime       @default(now())
  incident       Incident       @relation(fields: [incidentId], references: [id], onDelete: Cascade)

  @@index([incidentId])
}

// IOC Model
model IOC {
  id                String          @id @default(uuid())
  organizationId    String
  value             String
  type              String          // IPV4, IPV6, DOMAIN, URL, MD5, SHA1, SHA256, CVE
  reputationScore   Float           @default(0.0) // 0 - 100
  label             String          @default("UNKNOWN") // MALICIOUS, SUSPICIOUS, UNKNOWN, BENIGN
  country           String?
  asn               String?
  associatedDomains Json            @default("[]") // Actual Postgres JSONB array
  associatedFiles   Json            @default("[]") // Actual Postgres JSONB array
  detectionCount    Int             @default(0)
  firstObserved     DateTime        @default(now())
  lastObserved      DateTime        @default(now())
  notes             String?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  organization      Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  enrichments       IOCEnrichment[]

  @@unique([organizationId, value])
  @@index([organizationId])
  @@index([value])
}

// IOC Enrichment Model
model IOCEnrichment {
  id          String   @id @default(uuid())
  iocId       String
  sourceName  String   // VirusTotal, AbuseIPDB, etc.
  queryTime   DateTime @default(now())
  confidence  Float    @default(100.0)
  rawResponse Json     @default("{}") // Actual Postgres JSONB payload
  cacheAge    Int      @default(86400) // cache TTL in seconds
  ioc         IOC      @relation(fields: [iocId], references: [id], onDelete: Cascade)

  @@index([iocId])
}

// Vulnerability Catalog Model
model Vulnerability {
  id               String               @id // CVE ID e.g. CVE-2021-44228
  title            String
  description      String
  cvssScore        Float
  severity         AlertSeverity        @default(MEDIUM)
  publishedDate    DateTime
  modifiedDate     DateTime
  isKnownExploited Boolean              @default(false)
  affectedProducts Json                 @default("[]") // Actual Postgres JSONB array
  references       Json                 @default("[]") // Actual Postgres JSONB array
  remediation      String?
  patchAvailable   Boolean              @default(true)
  assets           AssetVulnerability[]
}

// Asset Vulnerability Mapping Model
model AssetVulnerability {
  id               String        @id @default(uuid())
  assetId          String
  cveId            String
  detectionMethod  String
  status           String        @default("OPEN") // OPEN, REMEDIATED, EXCEPTION, FALSE_POSITIVE
  exceptionStatus  String?
  dueDate          DateTime?
  ownerId          String?
  remediationNotes String?
  firstDetected    DateTime      @default(now())
  lastDetected     DateTime      @default(now())
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  asset            Asset         @relation(fields: [assetId], references: [id], onDelete: Cascade)
  vulnerability    Vulnerability @relation(fields: [cveId], references: [id], onDelete: Cascade)

  @@unique([assetId, cveId])
  @@index([assetId])
  @@index([cveId])
}

// Security Event (SIEM logs) Model
model SecurityEvent {
  id             String        @id @default(uuid())
  organizationId String
  timestamp      DateTime      @default(now())
  eventType      String
  source         String
  assetId        String?
  userIdentity   String?
  sourceIp       String?
  destinationIp  String?
  action         String
  outcome        String        @default("UNKNOWN") // SUCCESS, FAILURE, BLOCKED, UNKNOWN
  severity       AlertSeverity @default(LOW)
  message        String
  metadata       Json          @default("{}")      // Actual Postgres JSONB payload
  rawJson        String
  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([organizationId, timestamp])
  @@index([organizationId, assetId])
  @@index([organizationId, eventType])
  @@index([organizationId, sourceIp])
  @@index([timestamp])
}

// Detection Rule Model
model DetectionRule {
  id                String       @id @default(uuid())
  organizationId    String
  name              String
  description       String
  category          String
  severity          String
  isEnabled         Boolean      @default(true)
  dataSource        String
  queryDefinition   String
  matchConditions   Json         @default("{}")      // Actual Postgres JSONB conditions
  suppressionPeriod Int          @default(0)   // In seconds
  tags              Json         @default("[]")      // Actual Postgres JSONB array
  mitreTechnique    String?
  author            String       @default("System")
  version           Int          @default(1)
  lastTriggered     DateTime?
  triggerCount      Int          @default(0)
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt
  organization      Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
}

// Integration Model
model Integration {
  id                   String       @id @default(uuid())
  organizationId       String
  name                 String
  type                 String       // IOC_INTEL, VULN_FEED, WEBHOOK, SLACK, etc.
  isEnabled            Boolean      @default(false)
  lastSync             DateTime?
  health               String       @default("UNKNOWN") // OK, FAILED, UNKNOWN
  configuration        Json         @default("{}")      // Actual Postgres JSONB configurations
  encryptedCredentials String? // Encrypted JSON string of keys/tokens
  createdAt            DateTime     @default(now())
  updatedAt            DateTime     @updatedAt
  organization         Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
}

// Audit Log Model
model AuditLog {
  id             String       @id @default(uuid())
  organizationId String
  actorId        String
  actorEmail     String
  action         String
  resourceType   String
  resourceId     String
  timestamp      DateTime     @default(now())
  ipAddress      String?
  userAgent      String?
  previousValues Json?        // Actual Postgres JSONB details
  newValues      Json?        // Actual Postgres JSONB details
  requestId      String
  outcome        String       // SUCCESS, FAILURE
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([organizationId, resourceType, resourceId])
  @@index([timestamp])
}
